# Copy to `.env` and fill in. Never commit the filled-in file.

# The single demo sign-in the console accepts while a real identity provider is
# not wired in. Replace both before any deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Name of the httpOnly session cookie.
AUTH_COOKIE_NAME=ecab_session

# Signing secret for the session cookie. Use a long random string — at least 32
# bytes, generated rather than chosen.
AUTH_SECRET=

# Jitsi Meet for video conferencing (FR-VID). Unset, the console falls back to
# the public meet.jit.si server and says so on screen — that server is neither
# Malawian nor Government-controlled, so FR-VID-01 and FR-DAT-06 are not met
# until this points at the Lilongwe deployment.
NEXT_PUBLIC_JITSI_DOMAIN=

# Salts the derived room name so it cannot be guessed from a session reference.
# Set a different value per environment. Not a substitute for a JWT.
NEXT_PUBLIC_JITSI_ROOM_SALT=
